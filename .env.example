MONGODB_USERNAME="your_username"
MONGODB_PASSWORD="your_password"
MONGODB_URI="mongodb+srv://your-cluster.mongodb.net"
MONGODB_DB_NAME="snowmilk"

# Chỉ điều khiển proxy legacy. API v2 luôn đòi session thật.
# Bật sau khi đã bootstrap và đăng nhập thử tài khoản owner đầu tiên.
AUTH_ENFORCEMENT="disabled"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_BOOTSTRAP_TOKEN="replace-with-a-one-time-random-token"

# Bật cùng AUTH_ENFORCEMENT trong maintenance window sau migration.
V2_OPERATIONS_ENABLED="disabled"
